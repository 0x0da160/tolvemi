fn solve(xs: List<Int>) -> Option<Pair<Int, Int>> =
  let st = fold(xs, pair(false, pair(0, 0)), |acc, x|
    if(fst(acc),
      pair(true, pair(if(lt(x, fst(snd(acc))), x, fst(snd(acc))), if(lt(snd(snd(acc)), x), x, snd(snd(acc))))),
      pair(true, pair(x, x)))) in
  if(fst(st), some(snd(st)), none[Pair<Int, Int>])
entry solve
